# PHPStan settings for SEO Pro Stats's own files, added to phpstan.neon.dist
# (which holds the settings every plugin made from the starter shares).
# Add the plugin's own folders under paths (for example blocks) and each
# ignore with the identifier, the file and the reason.
parameters:
	paths:
		- collect.php
	ignoreErrors:
		# SEO Pro Stats has no settings features, tabs to rename or admin
		# parts yet: those lists in SEOProStats_Setup are empty and admin()
		# does nothing, so PHPStan reads the core code that uses them as
		# having no effect. Drop each ignore once its list or method is filled.
		-
			identifier: foreach.emptyArray
			path: includes/class-seoprostats.php
		-
			identifier: staticMethod.resultUnused
			path: admin/settings.php
		-
			identifier: function.impossibleType
			message: '#array_key_exists\(\) with mixed and array\{\}#'
			path: includes/class-seoprostats-settings.php
