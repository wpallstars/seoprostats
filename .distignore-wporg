# Files left out of the WordPress.org build, on top of .distignore
# (rsync exclude patterns; a leading / anchors to the plugin folder).
# Plugins hosted on WordPress.org may not install or update code from
# anywhere else, so updates from GitHub stay in GitHub releases only.
# scripts/build-release.sh also removes the Git Updater header lines
# (GitHub Plugin URI, Primary Branch, Release Asset) from seoprostats.php.
/includes/github-updater/
# The fast collector endpoint is requested directly, without WordPress, so
# it cannot have the ABSPATH guard WordPress.org asks of every PHP file.
# That build posts hits to the REST route instead (SEOProStats_Collection).
/collect.php
# Keep README.md: the admin Read Me tab shows it (admin/data/readme.php).
